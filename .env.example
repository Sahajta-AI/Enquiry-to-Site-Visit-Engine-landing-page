# ==============================================================================
# SAHAJTA AI - ENQUIRY-TO-SITE-VISIT ENGINE CONFIGURATION
# ==============================================================================

# Destination inbox(es) where internal lead summaries should be sent.
DESTINATION_EMAIL=

# ------------------------------------------------------------------------------
# WHATSAPP ATTENDANCE CONFIRMATION CONFIG
# ------------------------------------------------------------------------------
# Sahajta AI WhatsApp Business Number (E.164 format without + or spaces, e.g. 919876543210)
WHATSAPP_NUMBER=

# Thank-you page settings (all optional; leave empty to keep the part hidden)
# BRIEFING_VIDEO_URL: the 2-minute pre-call video. Empty = the page shows only the homework.
# BRIEFING_VIDEO_POSTER / BRIEFING_VIDEO_CAPTIONS: poster image and .vtt captions file for it.
# DEMO_WHATSAPP_NUMBER: the live demo assistant's number (country code, no + or spaces). Empty = demo section hidden.
BRIEFING_VIDEO_URL=
BRIEFING_VIDEO_POSTER=
BRIEFING_VIDEO_CAPTIONS=
DEMO_WHATSAPP_NUMBER=

# ------------------------------------------------------------------------------
# CALENDAR EMBED CONFIG
# ------------------------------------------------------------------------------
# Calendar Embed URL
CALENDAR_EMBED_URL=

# ------------------------------------------------------------------------------
# META PIXEL & CONVERSIONS API (CAPI) TRACKING
# ------------------------------------------------------------------------------
META_PIXEL_ID=
META_CAPI_TOKEN=

# ------------------------------------------------------------------------------
# CAL.COM API KEY FOR REAL-TIME FREE SLOT SYNC
# ------------------------------------------------------------------------------
CAL_API_KEY=

# ------------------------------------------------------------------------------
# ODOO CRM INTEGRATION (DORMANT STUB - UNCOMMITTED UNTIL USER GIVES DETAILS)
# ------------------------------------------------------------------------------
ODOO_ENDPOINT_URL=
ODOO_API_KEY=

# ------------------------------------------------------------------------------
# EMAIL DISPATCH METHOD 1: Nodemailer (SMTP / Gmail)
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_char_app_password

# ------------------------------------------------------------------------------
# EMAIL DISPATCH METHOD 2: Resend API Key
# ------------------------------------------------------------------------------
RESEND_API_KEY=
FROM_EMAIL=

# ------------------------------------------------------------------------------
# PLANNED, NOT USED YET: automatic emails (Thank-you Page Brief v1, parts 1 and 8)
# Names are proposals until the boss approves the tools. Nothing reads them today.
# Secrets go in through 1Password into Vercel and Cal.com: never in chat or email.
# ------------------------------------------------------------------------------
# SITE_URL=                        # https://warmchain.sahajta.com (production) or the preview's own address
# CAL_WEBHOOK_SECRET=              # checks Cal.com's x-cal-signature-256 header
# GOOGLE_CLIENT_ID=                # Gmail API, Google Cloud project inside sahajta.com Workspace (Internal)
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=            # from the one-time sign-in (gmail.send + gmail.metadata)
# UPSTASH_REDIS_REST_URL=          # the small store
# UPSTASH_REDIS_REST_TOKEN=
# QSTASH_TOKEN=                    # the delayed job (second email, nudges)
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=
# BACKUP_ALERT_API_KEY=            # backup alert if Gmail itself fails (Resend key can be reused: RESEND_API_KEY)

# Server Port
PORT=3000
