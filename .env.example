# ==============================================================================
# SAHAJTA AI - ENQUIRY-TO-SITE-VISIT ENGINE CONFIGURATION
# ==============================================================================

# Destination inbox(es) where internal lead summaries should be sent.
DESTINATION_EMAIL=

# ------------------------------------------------------------------------------
# WHATSAPP ATTENDANCE CONFIRMATION CONFIG
# ------------------------------------------------------------------------------
# Sahajta AI WhatsApp Business Number (E.164 format without + or spaces, e.g. 919876543210)
WHATSAPP_NUMBER=

# Thank-you page settings (all optional; leave empty to keep the part hidden)
# BRIEFING_VIDEO_URL: the 2-minute pre-call video. Empty = the page shows only the homework.
# BRIEFING_VIDEO_POSTER / BRIEFING_VIDEO_CAPTIONS: poster image and .vtt captions file for it.
# DEMO_WHATSAPP_NUMBER: the live demo assistant's number (country code, no + or spaces). Empty = demo section hidden.
BRIEFING_VIDEO_URL=
BRIEFING_VIDEO_POSTER=
BRIEFING_VIDEO_CAPTIONS=
DEMO_WHATSAPP_NUMBER=

# ------------------------------------------------------------------------------
# META PIXEL AND CONVERSIONS API (Backend and Tracking Brief, parts 5, 11 and 13)
# The live Pixel is used on Production only. Previews and local copies use the Sandbox Pixel.
# The code never falls back to the live Pixel: with no Sandbox values on a preview, no Pixel loads.
# ------------------------------------------------------------------------------
META_PIXEL_ID=                 # Production only: 909588332098654
META_CAPI_TOKEN=               # Production only, Secret
META_TEST_EVENT_CODE=          # Production only: used by the test page's live check only
META_SANDBOX_PIXEL_ID=         # All environments (never connect this Pixel to an ad account)
META_SANDBOX_CAPI_TOKEN=       # All environments, Secret
META_SANDBOX_TEST_EVENT_CODE=  # All environments
META_GRAPH_VERSION=            # All environments, Meta's latest stable version, for example v26.0

# Microsoft Clarity (loads only when this is set and NEW_TRACKING is on)
CLARITY_PROJECT_ID=

# Test bookings and the private test page (/tracking-test)
TEST_EMAILS=                   # your test email and Shubhang's, comma-separated
TEST_PAGE_PASSWORD=            # a long password, Secret
ALERT_EMAIL=                   # where failure alerts go (default: shubhang@sahajta.com)

# ------------------------------------------------------------------------------
# CAL.COM API KEY FOR REAL-TIME FREE SLOT SYNC
# ------------------------------------------------------------------------------
CAL_API_KEY=

# ------------------------------------------------------------------------------
# ODOO (Odoo Brief v1, part 9): leads into Odoo, and the signals after the call
# ------------------------------------------------------------------------------
ODOO_URL=https://sahajta.odoo.com   # Production, Preview
ODOO_DB=                       # Production, Preview: the database name
ODOO_API_KEY=                  # Production, Preview, Secret (Shubhang's own key; check its end date in Odoo)
# CRON_SECRET (Production, Secret) is also needed by the signal job: /api/cron/odoo-signals

# ------------------------------------------------------------------------------
# EMAIL DISPATCH METHOD 1: Nodemailer (SMTP / Gmail)
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_char_app_password

# ------------------------------------------------------------------------------
# EMAIL DISPATCH METHOD 2: Resend API Key
# ------------------------------------------------------------------------------
RESEND_API_KEY=
FROM_EMAIL=

# ------------------------------------------------------------------------------
# AUTOMATIC EMAILS (Thank-you Page Brief v1, parts 1, 7 and 8)
# Secrets go in through 1Password into Vercel and Cal.com: never in chat or email.
# Preview and production use separate values where noted (Vercel: set per environment).
# ------------------------------------------------------------------------------
# This site's own address. Production: https://warmchain.sahajta.com (until it is live, the vercel.app address).
# Empty on a preview = the preview's own address. Used in the emails' links and the queue's call-back.
SITE_URL=

# Which Cal.com event gets the booking. Production: 6659881 (the real event). Preview: 7785231 (the hidden test copy).
CAL_EVENT_TYPE_ID=

# Cal.com "Booking Created" webhook secret (Shubhang sets the same secret in Cal.com's webhook and here).
# Webhook address: {SITE_URL}/api/cal-webhook
CAL_WEBHOOK_SECRET=

# Gmail API on shubhang@sahajta.com (Google Cloud project inside the Workspace, consent screen: Internal).
# Get the refresh token once with: node scripts/gmail-token.js
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# GMAIL_SENDER=shubhang@sahajta.com   # optional, this is the default

# The small store (Upstash Redis, free tier)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# The delayed job (Upstash QStash, free tier; the EU region needs its own URL)
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Backup alert if Gmail itself fails: Resend (RESEND_API_KEY above) sends to this address.
# ALERT_EMAIL_TO=shubhangsethi@gmail.com   # optional, this is the default

# NEW_TRACKING holds back everything that needs the new privacy and cookie policy: the server's sends to the live Pixel,
# the source data on bookings and in the nudge records, the new browser events and Clarity.
# Values: on or off. Empty means on for previews and local copies, and OFF on Production.
# Production stays off until the updated policy pages are live; then set it to on.
NEW_TRACKING=

# The two nudge emails to people who leave without booking. Off until launch: set to 1 to switch on.
NUDGES_ENABLED=
# NUDGE_DAILY_LIMIT=20        # optional: most nudge pairs started a day (by IST day)

# PREVIEW ONLY (ignored on production), for testing the nudges quickly:
# NUDGE_TEST_WAITS=2,5          # first nudge 2 minutes after they leave, second 5 minutes after the first
# RESUME_CODE_TTL_MINUTES=10    # a short expiry for a nudge's link

# Only if the delayed job later moves from QStash to Vercel Cron (Vercel Pro):
# SCHEDULER=cron
# CRON_SECRET=                  # Vercel sends it to /api/jobs/tick; add a cron entry for /api/jobs/tick in vercel.json

# Vercel adds VERCEL_AUTOMATION_BYPASS_SECRET by itself when "Protection Bypass for Automation" is on.

# Server Port
PORT=3000
