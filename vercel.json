{
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" }
  ],
  "redirects": [
    { "source": "/fit-and-book", "destination": "/", "permanent": false },
    { "source": "/thank-you", "destination": "/", "permanent": false }
  ],
  "functions": {
    "api/index.js": {
      "excludeFiles": "{public/**,.env*}"
    }
  }
}
